# bot.py — финальная версия from telegram import Update, ReplyKeyboardMarkup from telegram.ext import Updater, CommandHandler, MessageHandler, Filters, CallbackContext # --------------------------- # Вставь сюда свой токен TOKEN = 'ВАШ_ТОКЕН_ТУТ' # --------------------------- # Состояние игры game_state = { 'time_of_day': 'день', # день / ночь 'characters': { 'Саня': {'role': 'работяга', 'status': 'норм'}, 'Илья': {'role': 'напарник БСУ', 'status': 'бдит'}, 'Андрей': {'role': 'технолог', 'status': 'следит'}, 'Юра': {'role': 'худой и высокий', 'status': 'ест много'}, 'Мишаня': {'role': 'сборщик', 'status': 'иногда сбрасывает'}, 'Тимур': {'role': 'СВ', 'status': 'ругает'} }, 'shift_counter': 1 } # Клавиатура main_keyboard = [['Начать смену'], ['Статус персонажей'], ['Мини-игра']] reply_markup = ReplyKeyboardMarkup(main_keyboard, one_time_keyboard=False, resize_keyboard=True) # Команды def start(update: Update, context: CallbackContext): update.message.reply_text( f"Привет! Это Tzsm Bot.\nСейчас {game_state['time_of_day']}. Смена №{game_state['shift_counter']}", reply_markup=reply_markup ) def status(update: Update, context: CallbackContext): msg = "Состояние персонажей:\n" for name, info in game_state['characters'].items(): msg += f"{name}: {info['status']}\n" update.message.reply_text(msg) def shift(update: Update, context: CallbackContext): # Меняем день/ночь game_state['time_of_day'] = 'ночь' if game_state['time_of_day'] == 'день' else 'день' game_state['shift_counter'] += 1 update.message.reply_text(f"Смена завершена! Теперь {game_state['time_of_day']}. Смена №{game_state['shift_counter']}") def mini_game(update: Update, context: CallbackContext): update.message.reply_text("Мини-игра: попробуй угадать число от 1 до 3!") context.user_data['game'] = 'mini_game' def text_handler(update: Update, context: CallbackContext): if context.user_data.get('game') == 'mini_game': answer = update.message.text.strip() if answer in ['1', '2', '3']: update.message.reply_text(f"Ты выбрал {answer}. Хорошая попытка!") context.user_data['game'] = None else: update.message.reply_text("Введите число от 1 до 3.") else: update.message.reply_text("Не понял команду. Используй клавиатуру.") def main(): updater = Updater(TOKEN, use_context=True) dp = updater.dispatcher dp.add_handler(CommandHandler('start', start)) dp.add_handler(MessageHandler(Filters.regex('^Статус персонажей$'), status)) dp.add_handler(MessageHandler(Filters.regex('^Начать смену$'), shift)) dp.add_handler(MessageHandler(Filters.regex('^Мини-игра$'), mini_game)) dp.add_handler(MessageHandler(Filters.text & ~Filters.command, text_handler)) print("Бот запущен...") updater.start_polling() updater.idle() if __name__ == '__main__': main()
